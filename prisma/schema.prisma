datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  brand         String
  description   String
  shortDesc     String   @default("")
  price         Float
  originalPrice Float
  discount      Int      @default(0)
  weight        String
  category      String
  region        String
  image         String
  images        String   @default("[]")    // JSON array of image URLs
  rating        Float    @default(0)
  reviews       Int      @default(0)
  tags          String   @default("[]")    // JSON array of tag strings
  highlights    String   @default("[]")    // JSON array of highlight strings
  variants      String   @default("[]")    // JSON array of variant objects
  fssai         String   @default("")
  ingredients   String   @default("")
  nutrition     String   @default("")
  allergens     String   @default("")
  shelfLife     String   @default("")
  isVegetarian  Boolean  @default(true)
  inStock       Boolean  @default(true)
  isNew         Boolean  @default(false)
  isBestseller  Boolean  @default(false)
}

model Order {
  id             String      @id @default(uuid())
  totalAmount    Float
  status         String      @default("PENDING") // PENDING, PAID, PENDING_COD, FAILED
  razorpayId     String?
  paymentMethod  String      @default("UPI")     // UPI, CARD, COD
  customerName   String      @default("")
  customerEmail  String      @default("")
  customerPhone  String      @default("")
  shippingAddress String     @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id])
}

model Referral {
  id          String   @id @default(uuid())
  code        String   @unique
  referrerId  String   @default("") // In a full app, this would be a User ID
  discountAmt Float    @default(100.0)
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
}
